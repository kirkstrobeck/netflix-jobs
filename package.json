{
  "name": "netflix-jobs",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "pnpm --filter web test && pnpm --filter @netflix-jobs/ingestor test",
    "test:coverage": "pnpm --filter web test:coverage && pnpm --filter @netflix-jobs/ingestor test:coverage",
    "test:lighthouse": "node tools/lighthouse/main.mjs",
    "test:structured-data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/structured-data/main.mjs",
    "test:types": "pnpm --filter web typecheck",
    "test:all": "pnpm test && pnpm test:types && pnpm test:structured-data && pnpm test:lighthouse",
    "db:forward": "node tools/supabase-port-forward.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "ingest": "pnpm --filter @netflix-jobs/ingestor ingest"
  },
  "devDependencies": {
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "playwright-core": "^1.62.1",
    "turbo": "^2.10.7"
  }
}
